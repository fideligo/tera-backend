# Copy to backend/.env and fill in. Never commit .env — no secrets in the repo (BUILD_SPEC 4.5).

# --- Database -----------------------------------------------------------------
# Port 5434 is what docker-compose.yml publishes the db service on.
TERA_DATABASE_URL=postgresql+psycopg://tera:tera_dev_password@localhost:5434/tera
# Tests create and drop their own database; this is the server they create it on.
TERA_TEST_DATABASE_URL=postgresql+psycopg://tera:tera_dev_password@localhost:5434/tera_test

# --- Auth ---------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TERA_JWT_SECRET=change-me-this-value-must-not-be-committed
TERA_ACCESS_TOKEN_TTL_MINUTES=15
TERA_REFRESH_TOKEN_TTL_DAYS=14

# --- Seed demo ----------------------------------------------------------------
# Passwords for the synthetic demo accounts created by `tera-seed-demo`.
# These accounts only ever hold synthetic data.
TERA_DEMO_PATIENT_PASSWORD=demo-patient-password
TERA_DEMO_CLINICIAN_PASSWORD=demo-clinician-password

# --- Runtime ------------------------------------------------------------------
TERA_ENV=development
TERA_LOG_LEVEL=INFO

# --- Optional LLM insight (Phase 4) --------------------------------------------
# Unset by default: no key means no call, ever. Consent is asked on the handset regardless of
# whether this is set; setting it only makes "yes" mean something. Never commit a real key —
# this file is the template, .env is git-ignored.
TERA_LLM_API_KEY=
TERA_LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
TERA_LLM_MODEL=meta/llama-3.1-8b-instruct
